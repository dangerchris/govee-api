{
  "name": "govee-api",
  "version": "1.0.0",
  "description": "TypeScript client library for Govee smart device API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangerchris/govee-api.git"
  },
  "keywords": [
    "govee",
    "api",
    "smart-home",
    "iot",
    "temperature",
    "humidity",
    "sensor"
  ],
  "author": "Chris Gander",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "typescript": "^5"
  }
}
